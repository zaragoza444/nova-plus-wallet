{
  "private": true,
  "name": "nova-plus-wallet",
  "version": "1.0.0",
  "description": "Nova Plus Wallet - Signet fork SPA for NovaONE / NRW / ALLTRA (novablockchainsystem.com/wallet/)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5199 --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5199",
    "deploy": "powershell -ExecutionPolicy Bypass -File ../nova/scripts/deploy-nova-plus-wallet.ps1",
    "build-from-nova": "powershell -ExecutionPolicy Bypass -File ../nova/scripts/deploy-nova-plus-wallet.ps1 -CopyToSiblingRepo"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
