# Signet — local environment (copy to .env.local, never commit secrets)

# SHA-256 hex hash of the institutional gate passphrase.
# Generate: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_GATE').digest('hex'))"
VITE_INSTITUTIONAL_GATE=

# Optional — 1inch swap API (public EVM only: ETH, BSC, …)
# VITE_1INCH_API_KEY=

# Optional — Nova Bank production API (HTTPS). Default probes novabank.uk then Railway.
# VITE_NOVA_API_URL=https://novabank.uk/api/v1

# Optional — OneX Online Bank API (local default http://127.0.0.1:8090/api/v1).
# VITE_ONEX_API_URL=http://127.0.0.1:8090/api/v1
# ONEX_PORT=8090
# ONEX_OPENING_CREDIT=1
# ONEX_MASTER_SECRET=
